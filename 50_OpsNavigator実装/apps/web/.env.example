# 情シス Ops Navigator — 環境変数(§10.5)。実値は .env.local へ(gitignore対象・commit禁止)。
# DEMO_ONLY: DBは127.0.0.1のローカルDEMO DBのみ。本番接続情報をここに書かない。
APP_ENV=local-demo
APP_BASE_URL=http://127.0.0.1:3111
DATABASE_URL="postgresql://opsnav_demo:opsnav_demo_only_local@127.0.0.1:5432/opsnav_demo"

# AI/外部接続は既定で無効(03C)。mock以外のproviderはGate 4まで承認されない。
AI_PROVIDER=mock
AI_ENABLED=false
VECTOR_SEARCH_ENABLED=false
EXTERNAL_WRITES_ENABLED=false

# 本番用(Gate 3以降・未承認)。ローカルでは空のまま。
GOOGLE_CLOUD_PROJECT=
GOOGLE_AUTH_DOMAIN_ALLOWLIST=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
DRIVE_ALLOWED_SHARED_DRIVE_IDS=
DRIVE_ALLOWED_FOLDER_IDS=
